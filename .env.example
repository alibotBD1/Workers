# Dépôt GitHub qui reçoit les offres publiées par les recruteurs (format propriétaire/nom)
VITE_GITHUB_REPO=alibotBD1/workers
# Mode démonstration : affiche des offres d'exemple fictives en plus des vraies offres
VITE_DEMO=true

# --- Firebase (Console Firebase > Paramètres du projet > Vos applications > Web) ---
# Ces valeurs sont publiques (elles figurent dans le site) : la sécurité repose sur les règles Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
# production ou recette
VITE_ENV=recette
